# Copy to `.env` and fill in the keys for whichever providers you use.
# `circuit-extract` loads this automatically via python-dotenv.

GEMINI_API_KEY=
# GOOGLE_API_KEY=  # alternate name accepted by google-genai

# HuggingFace token for downloading gated datasets (hanky2397/schematic_images).
# Create one at https://huggingface.co/settings/tokens (read access is enough).
# You must also accept the dataset's access terms on its HuggingFace page.
HF_TOKEN=
